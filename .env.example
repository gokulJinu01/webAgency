# Backend: use a MongoDB Atlas or local MongoDB connection string. Never prefix with VITE_.
MONGODB_URI=mongodb://127.0.0.1:27017/goku-studio
PORT=3001
CLIENT_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0
# Frontend: public Express origin, baked into the frontend at build time.
# Leave blank for an explicitly unavailable enquiry form in the hosted design preview.
VITE_API_URL=
