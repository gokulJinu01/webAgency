# Copy to .env for local dev, and add the same variables in Vercel → Project → Settings → Environment Variables.
# All values are public (they end up in the built site), so no secrets belong here.

# Web3Forms access key — get one free at https://web3forms.com using the email you want enquiries sent to.
# Leave blank and the form tells visitors to email you directly instead.
VITE_WEB3FORMS_KEY=

# Optional booking link (Cal.com or Calendly). The "Book a call" button only appears when this is set.
VITE_BOOKING_URL=
